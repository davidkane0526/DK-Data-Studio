    "icon": "▧",
    "title": "TER 分析"
  },
  "scripts": [
    "controller.js",
    "analysis-service.js",
    "feature-utils.js",
    "selection-link-runtime.js",
    "unit-presentation.js",
    "feature-runtime.js",
    "super-layout.js",
    "domain-adapter.js",
    "plugin.js"
  ],
  "algorithmCategories": [
    "transport-transform",
    "transport-scalar-field",
    "ter-analysis"
