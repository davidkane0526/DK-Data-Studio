  ],
  "platformPresentation": {
    "desktop": {
      "mode": "shared"
    },
    "mobile": {
      "mode": "adaptive"
    }
  },
  "tasks": [
    {
      "id": "resonant-ter",
      "entry": "ter-resonant-task.js",
      "imports": [
        "task-core.js"
      ]
    }
  ]
