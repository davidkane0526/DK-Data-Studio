    "data.types",
    "data.artifacts",
    "data.pipeline",
    "ui.plugin-workspace",
    "ui.scientific-plot",
    "ui.group-area",
    "ui.unit-templates",
    "ui.table"
  ],
  "window": {
    "activity": "ter",
    "runtime": "window-runtime.js",
    "title": "TER 分析",
    "width": 1480,
    "height": 940,
    "minWidth": 920,
    "minHeight": 650,
    "dependencies": [
      "data-model",
      "scientific-renderer",
      "science-common",
      "science-peaks",
      "science-ter",
      "parameter-schema",
      "platform",
      "ui-infrastructure",
      "plugin-kernel"
    ],
    "prewarm": true,
    "reuse": true,
    "persistence": "project",
    "artifactHydration": "live",
    "scripts": [
      "controller.js",
      "feature-utils.js",
      "selection-link-runtime.js",
      "unit-presentation.js",
      "feature-runtime.js",
