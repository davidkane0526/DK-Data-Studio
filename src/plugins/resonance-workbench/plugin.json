{
  "id": "builtin.resonance-workbench",
  "name": "Resonance Workbench",
  "version": "2.3.0",
  "apiVersion": "1.3.0",
  "entry": "plugin.js",
  "enabled": true,
  "order": 100,
  "description": "Full resonance TOP/SUPER workbench with a dedicated independent renderer that preserves curve inspection, grouped plots, physics, spacing and gate analysis.",
  "capabilities": [
    "ui.activity",
    "ui.sidebar",
    "ui.inspector",
    "ui.group-charts",
    "ui.main-tools",
    "analysis.resonance",
    "chart.trend",
    "ui.selection-menu",
    "ui.top-workspace",
    "ui.prime",
    "ui.sub"
  ],
  "workspace": {
    "role": "top",
    "activity": "resonance",
    "icon": "∿",
    "title": "共振分析"
  },
  "window": {
    "activity": "resonance",
    "title": "共振分析",
    "width": 1480,
    "height": 940,
    "minWidth": 920,
    "minHeight": 650,
    "prewarm": false,
    "reuse": true,
    "persistence": "project",
    "runtime": "window-runtime.js",
    "dependencies": [
      "plotly",
      "science-common",
      "science-presets",
      "science-import",
      "science-peaks",
      "science-identity",
      "science-physics",
      "science-gate",
      "science-ter",
      "platform",
      "plugin-kernel"
    ]
  }
}
