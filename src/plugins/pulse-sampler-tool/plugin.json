{
  "id": "com.dkds.tools.pulse-sampler",
  "name": "脉冲与采样处理",
  "version": "1.4.0",
  "apiVersion": "1.18.0",
  "entry": "plugin.js",
  "scripts": ["plugin.js"],
  "styles": ["plugin.css"],
  "enabled": true,
  "order": 360,
  "description": "Vd/Vs/Vg 三路脉冲生成、片段拼接、统一波形预览，以及按脉冲时间轴对工程数据进行稳态采样。",
  "pluginType": "tool",
  "requiresCore": [
    "events", "status", "state", "project", "workspace",
    "data.sources", "data.artifacts", "data.model",
    "ui.dom", "ui.workspace", "ui.scientific-plot", "ui.series", "ui.table",
    "ui.actions", "ui.activities", "ui.top-workspace", "ui.pages"
  ],
  "capabilities": [
    "ui.page", "ui.top-workspace", "ui.plugin-workspace", "ui.scientific-plot",
    "ui.table", "data.scoped-sources"
  ],
  "workspace": {"role":"top","activity":"pulse-sampler-tool","icon":"⌁","title":"脉冲与采样处理"},
  "window": {
    "activity":"pulse-sampler-tool","title":"脉冲与采样处理",
    "width":1320,"height":860,"minWidth":960,"minHeight":640,
    "dependencies":["scientific-renderer","data-model"],
    "prewarm":false,"reuse":true,"persistence":"project","artifactHydration":"live"
  },
  "data": {"accepts":["data.table","science.transport.iv","science.transport.transfer"]},
  "compatibility": {"app":">=3.62.0 <4.0.0","pluginApi":"^1.18.0"}
}
