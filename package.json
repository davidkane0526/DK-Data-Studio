{
  "name": "graphene-resonance-studio",
  "version": "3.19.0-plugin.1",
  "description": "Plugin-oriented interactive scientific data analysis studio (Graphene resonance built-in plugins)",
  "main": "main.js",
  "author": "Graphene Resonance Studio contributors",
  "license": "MIT",
  "scripts": {
    "plugin:index": "node scripts/generate-plugin-index.js",
    "plugin:validate": "node scripts/validate-plugins.js",
    "start": "node scripts/generate-plugin-index.js && node scripts/validate-plugins.js && electron .",
    "test": "node scripts/generate-plugin-index.js && node scripts/validate-plugins.js && node scripts/test-plugin-manager.js && node scripts/test-plugin-package.js && node scripts/test-data-center-core.js && node tests.js",
    "check": "node scripts/generate-plugin-index.js && node scripts/validate-plugins.js && node scripts/check-project.js && node scripts/test-plugin-manager.js && node scripts/test-plugin-package.js && node scripts/test-data-center-core.js && node scripts/verify-science-parity.js && node scripts/check-plugin-boundaries.js",
    "dist": "node scripts/generate-plugin-index.js && node scripts/validate-plugins.js && node scripts/prepare-build.js && electron-builder --win nsis portable --publish never && node scripts/verify-dist.js",
    "update-server": "node update-server/server.js",
    "publish:update": "node update-server/publish-release.js dist",
    "science:parity": "node scripts/verify-science-parity.js",
    "mobile:sync": "cd mobile && npm run sync:web",
    "mobile:android": "cd mobile && npm run android",
    "plugin-manager:test": "node scripts/test-plugin-manager.js",
    "data-center:test": "node scripts/test-data-center-core.js",
    "plugin:package": "node scripts/package-plugin.js",
    "plugin-package:test": "node scripts/test-plugin-package.js"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "plotly.js-dist-min": "^3.1.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.18.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "org.openai.graphene-resonance-studio",
    "productName": "Graphene Resonance Studio",
    "files": [
      "main.js",
      "plugin-package.js",
      "update-client.js",
      "lan-web-server.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "build-info.json",
      "update-config.default.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:45880/releases/bootstrap/"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16"
  }
}
