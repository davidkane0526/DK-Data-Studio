    "project",
    "data.types",
    "data.sources",
    "ui.workspace",
    "ui.unit-templates",
    "ui.actions",
    "ui.scientific-plot",
    "ui.interaction-behavior",
    "ui.pages"
  ],
  "capabilities": [
    "ui.page",
    "ui.interaction-behavior",
    "ui.scientific-plot",
    "state.store",
    "data.types",
    "data.sources",
    "ui.plugin-workspace"
  ],
  "pluginType": "workbench",
  "data": {"accepts": ["science.transport.iv"]}
}
