{
  "version": "2.5.38",
  "primitivePolicies": {
    "button": {
      "unit": "action",
      "factory": "action.create",
      "rule": "Every ordinary interactive button is expressible as an Action Unit or as a mandatory Core chrome action."
    },
    "input": {
      "unit": "field",
      "factory": "field.create",
      "rule": "Text/number/range inputs use Field; checkbox/radio inputs use Check."
    },
    "select": {
      "unit": "field",
      "factory": "field.create",
      "rule": "Select controls use Field/select or schema ParameterForm."
    },
    "textarea": {
      "unit": "field",
      "factory": "field.create",
      "rule": "Textarea controls use Field/textarea."
    },
    "checkbox": {
      "unit": "check",
      "factory": "check.create",
      "rule": "Checkbox/radio geometry and alignment are Core-owned."
    },
    "table": {
      "unit": "table",
      "factory": "table.mount",
      "rule": "Data tables use the managed Table Unit."
    },
    "header": {
      "unit": "header",
      "factory": "header.create",
      "rule": "Panel/section/portable headers use Header unless a stronger Unit creates its header."
    },
    "surface": {
      "unit": "surface",
      "factory": "surface.create",
      "rule": "Canonical material surfaces use Surface/Panel."
    },
    "plot": {
      "unit": "scientificPlot",
      "factory": "scientificPlot.create",
      "rule": "Chrome-free plot canvas is ScientificPlot; complete data figure is PlotView."
    },
    "status": {
      "unit": "status",
      "factory": "status.create/status.contribute",
      "rule": "Local/global status presentation uses Status."
    }
  },
  "chromePolicies": {
    "plotViewComplete": {
      "unit": "plotView",
      "variant": "complete",
      "header": "required",
      "title": "required",
      "coreActions": [
        "placement",
        "export"
      ],
      "logicalOrder": [
        "placement",
        "export",
        "domain-actions"
      ],
      "domainActions": "optional-after-export",
      "invariants": [
        "header is always present",
        "placement control is always present because a PlotView is movable",
        "export menu is always present and contains at least one export/copy action",
        "plugin actions may extend but may not replace Core placement/export actions"
      ]
    },
    "plotGroupStandard": {
      "unit": "plotGroup",
      "header": "standard",
      "title": "required",
      "meta": "optional",
      "coreActions": [
        "placement",
        "columns",
        "collapse",
        "close"
      ],
      "logicalOrder": [
        "placement",
        "columns",
        "domain-actions",
        "collapse",
        "close"
      ],
      "domainActions": "optional-between-columns-and-collapse",
      "invariants": [
        "standard group header is complete; partial group chrome is forbidden",
        "columns control is Core-owned",
        "placement/collapse/close are Core-owned",
        "every child is a complete PlotView"
      ]
    },
    "plotGroupTitleless": {
      "unit": "plotGroup",
      "header": "none",
      "title": "forbidden",
      "coreActions": [],
      "logicalOrder": [],
      "domainActions": "forbidden",
      "invariants": [
        "titleless group is fixed to exactly one placement",
        "titleless group exposes no placement/collapse/close chrome"
      ]
    },
    "movableInspector": {
      "unit": "prime",
      "role": "inspector",
      "header": "required",
      "title": "required",
      "coreActions": [
        "placement",
        "close"
      ],
      "optionalCoreActions": [
        "collapse"
      ],
      "logicalOrder": [
        "placement",
        "domain-actions",
        "collapse?",
        "close"
      ],
      "invariants": [
        "movable inspector uses canonical header",
        "close is always discoverable"
      ]
    },
    "movableDataControl": {
      "unit": "prime",
      "role": "data-control",
      "header": "required",
      "title": "required",
      "coreActions": [
        "placement",
        "close"
      ],
      "optionalCoreActions": [
        "collapse"
      ],
      "logicalOrder": [
        "placement",
        "domain-actions",
        "collapse?",
        "close"
      ],
      "invariants": [
        "movable data-control uses canonical header"
      ]
    },
    "fixedDataControl": {
      "unit": "prime",
      "role": "data-control",
      "header": "optional",
      "coreActions": [],
      "logicalOrder": [],
      "invariants": [
        "single-placement fixed data-control never exposes a placement chooser"
      ]
    },
    "scientificSecondary": {
      "unit": "prime",
      "role": "scientific-secondary",
      "header": "required",
      "title": "required",
      "coreActions": [
        "placement",
        "collapse",
        "close"
      ],
      "logicalOrder": [
        "placement",
        "domain-actions",
        "collapse",
        "close"
      ],
      "invariants": [
        "scientific-secondary canonical header is complete"
      ]
    },
    "portable": {
      "unit": "portable",
      "header": "required-when-chrome",
      "coreActions": [
        "placement"
      ],
      "optionalCoreActions": [
        "collapse",
        "close"
      ],
      "invariants": [
        "placement is injected only when more than one placement is available",
        "drag/resize/placement have one Core owner"
      ]
    }
  },
