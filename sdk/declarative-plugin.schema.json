{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dk-data-studio.local/schema/declarative-plugin-v1.json",
  "title": "DK Data Studio Declarative Plugin Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plugin",
    "page",
    "workspace",
    "data",
    "content"
  ],
  "properties": {
    "schema": {
      "const": "dkds.declarative-plugin.v1"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "number",
          "default": 900
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "analysis",
            "tool"
          ],
          "default": "analysis"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity",
        "primaryRole"
      ],
      "properties": {
        "activity": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "primaryRole": {
          "enum": [
            "scientific-primary",
            "data-primary",
            "utility-primary"
          ]
        },
        "primaryLabel": {
          "type": "string",
          "default": "主界面"
        },
        "primaryScroll": {
          "enum": [
            "safe",
            "contained"
          ],
          "default": "safe"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepts"
      ],
      "properties": {
        "accepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "produces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "statusMessage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "enum": [
              "primary",
              "secondary",
              "quiet"
            ]
          },
          "statusMessage": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "type": {
                "enum": [
                  "number",
                  "text",
                  "select",
                  "checkbox"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "step": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "label"
                  ],
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "note"
              },
              "text": {
                "type": "string"
              },
              "variant": {
                "enum": [
                  "meta",
                  "ordinary"
                ],
                "default": "meta"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "title",
              "xTitle",
              "yTitle"
            ],
            "properties": {
              "kind": {
                "const": "plot"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "xTitle": {
                "type": "string"
              },
              "yTitle": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "selectionTarget": {
                "enum": [
                  "series"
                ],
                "default": "series"
              },
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                  },
                  "entityType": {
                    "type": "string",
                    "minLength": 1,
                    "default": "data.series"
                  }
                }
              },
              "axisSemantics": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "unit": {
                        "type": "string"
                      },
                      "dimension": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "string"
                      }
                    }
                  },
                  "y": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "unit": {
                        "type": "string"
                      },
                      "dimension": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "viewport": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "linkGroup"
                ],
                "properties": {
                  "link": {
                    "type": "boolean",
                    "default": false
                  },
                  "linkGroup": {
                    "type": "string",
                    "minLength": 1
                  },
                  "linkedAxes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "x",
                        "y"
                      ]
                    },
                    "default": [
                      "x",
                      "y"
                    ]
                  }
                }
              },
              "legend": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "linkGroup"
                ],
                "properties": {
                  "link": {
                    "type": "boolean",
                    "default": false
                  },
                  "linkGroup": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxLinkedTargets": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24,
                    "default": 24
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "title",
              "columns"
            ],
            "properties": {
              "kind": {
                "const": "table"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "label"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": "string"
                    }
                  }
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "title",
              "plots"
            ],
            "properties": {
              "kind": {
                "const": "plot-group"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12,
                "default": 2
              },
              "maxColumns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12,
                "default": 4
              },
              "minItemWidth": {
                "type": "integer",
                "minimum": 120,
                "maximum": 1200,
                "default": 260
              },
              "density": {
                "enum": [
                  "compact",
                  "regular",
                  "comfortable"
                ],
                "default": "regular"
              },
              "responsive": {
                "type": "boolean",
                "default": true
              },
              "plots": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "xTitle": {
                      "type": "string"
                    },
                    "yTitle": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ]
                      }
                    },
                    "selectionTarget": {
                      "enum": [
                        "series"
                      ],
                      "default": "series"
                    },
                    "identity": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "input"
                      ],
                      "properties": {
                        "input": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                        },
                        "entityType": {
                          "type": "string",
                          "minLength": 1,
                          "default": "data.series"
                        }
                      }
                    },
                    "axisSemantics": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "x": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "unit": {
                              "type": "string"
                            },
                            "dimension": {
                              "type": "string"
                            },
                            "quantity": {
                              "type": "string"
                            }
                          }
                        },
                        "y": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "unit": {
                              "type": "string"
                            },
                            "dimension": {
                              "type": "string"
                            },
                            "quantity": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    "viewport": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "linkGroup"
                      ],
                      "properties": {
                        "link": {
                          "type": "boolean",
                          "default": false
                        },
                        "linkGroup": {
                          "type": "string",
                          "minLength": 1
                        },
                        "linkedAxes": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "x",
                              "y"
                            ]
                          },
                          "default": [
                            "x",
                            "y"
                          ]
                        }
                      }
                    },
                    "legend": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "linkGroup"
                      ],
                      "properties": {
                        "link": {
                          "type": "boolean",
                          "default": false
                        },
                        "linkGroup": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxLinkedTargets": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 24,
                          "default": 24
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "multiple": {
              "type": "boolean",
              "default": true
            },
            "defaultType": {
              "type": "string",
              "minLength": 1,
              "default": "data.series"
            }
          }
        },
        "selectionLink": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "group": {
              "type": "string",
              "minLength": 1
            },
            "acceptTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
