{
  "expo": {
    "name": "DK Data Studio",
    "slug": "dk-data-studio",
    "version": "0.7.1",
    "orientation": "default",
    "android": {
      "package": "com.dk.datastudio",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      }
    },
    "plugins": [
      "./plugins/withDkdsWebAssets.js",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "dark"
        }
      ],
      "./plugins/withDkdsAndroidNativeHost.js",
      "./plugins/withDkdsReleaseSigning.js"
    ],
    "icon": "./assets/icon.png"
  }
}
