// Generic authenticated TCP gateway for paired browser clients.
// All operations use bounded byte payloads, private-network targets and owner-scoped sessions.
private object DkdsLanTcp {
  private data class Session(
    val id:String,
    val owner:String,
    val socket:Socket,
    @Volatile var busy:Boolean=false,
    @Volatile var lastUsed:Long=System.currentTimeMillis()
  )
  private val sessions=ConcurrentHashMap<String,Session>()
  private const val TTL_MS=120000L
  private const val MAX_SESSIONS=32
  private const val MAX_SESSIONS_PER_OWNER=8
  private const val MAX_WRITE_BYTES=1024*1024
  private const val MAX_RESPONSE_BYTES=8*1024*1024

  @Synchronized fun closeAll(){
    for((id,row) in sessions){
      if(sessions.remove(id,row))try{row.socket.close()}catch(_:Throwable){}
    }
  }
  private fun closeRow(row:Session){
    sessions.remove(row.id,row)
    try{row.socket.close()}catch(_:Throwable){}
  }
  private fun cleanExpired(){
    val now=System.currentTimeMillis()
    for((_,row) in sessions){
      if(!row.busy&&now-row.lastUsed>TTL_MS)closeRow(row)
    }
  }
  private fun requireOwned(id:String,owner:String):Session{
    cleanExpired()
    val row=sessions[id] ?: throw IllegalStateException("TCP session is unavailable or expired. Reconnect.")
    if(row.owner!=owner)throw SecurityException("TCP session does not belong to this paired browser.")
    row.lastUsed=System.currentTimeMillis()
    return row
  }
  private fun bounded(value:Int,min:Int,max:Int,label:String):Int{
    if(value<min||value>max)throw IllegalArgumentException(label+" is outside allowed bounds.")
    return value
  }
  private fun isPrivateAddress(address:InetAddress):Boolean{
    if(address is java.net.Inet4Address){
      val b=address.address.map{it.toInt() and 255}
      return b[0]==10 || (b[0]==172&&b[1] in 16..31) ||
        (b[0]==192&&b[1]==168) || (b[0]==169&&b[1]==254)
    }
    val bytes=address.address
    val uniqueLocal=bytes.isNotEmpty()&&(bytes[0].toInt() and 0xfe)==0xfc
    return address.isLinkLocalAddress||address.isSiteLocalAddress||uniqueLocal
  }
  private fun resolvePrivateTarget(host:String):InetAddress{
    val addresses=try{InetAddress.getAllByName(host).toList()}catch(error:Throwable){
      throw IllegalArgumentException("TCP target could not be resolved: "+(error.message?:error.javaClass.simpleName))
    }
    if(addresses.isEmpty()||addresses.any{!isPrivateAddress(it)})
      throw SecurityException("LAN TCP gateway accepts private-network targets only.")
    return addresses.first()
  }
  fun execute(context:Context,owner:String,req:JSONObject):JSONObject{
    val payload=req.optJSONObject("payload") ?: JSONObject()
    return when(req.optString("op","")){
      "open"->open(context,owner,payload)
      "exchange"->exchange(owner,payload)
      "close"->{
        val row=requireOwned(payload.optString("sessionId",""),owner)
        synchronized(row){if(row.busy)throw IllegalStateException("TCP session has an active exchange.")}
        closeRow(row)
        JSONObject().put("closed",true)
      }
      else->throw IllegalArgumentException("Unsupported TCP gateway operation.")
    }
  }
  private fun fallbackSources(mode:String,iface:String,linkLocal:Boolean):List<Pair<String,java.net.Inet4Address>>{
    val all=try{java.util.Collections.list(java.net.NetworkInterface.getNetworkInterfaces())}
      catch(_:Throwable){emptyList<java.net.NetworkInterface>()}
    val names=when(mode){
      "interface"->listOf(iface)
      "ethernet"->all.map{it.name}.filter{it.startsWith("eth")||it.startsWith("enx")||it.startsWith("usb")||it.contains("ethernet",true)||it.contains("以太网")}
      "wifi"->all.map{it.name}.filter{it.startsWith("wlan")||it.startsWith("wifi")||it.startsWith("wlp")||it.contains("wireless",true)||it.contains("无线")}
      else->all.map{it.name}
    }.distinct().sortedWith(compareBy<String>{
      when{
        it.startsWith("eth")||it.startsWith("enx")||it.startsWith("usb")||it.contains("ethernet",true)||it.contains("以太网")->0
        it.startsWith("wlan")||it.startsWith("wifi")||it.startsWith("wlp")||it.contains("wireless",true)||it.contains("无线")->1
        else->2
      }
    })
    val rows=mutableListOf<Pair<String,java.net.Inet4Address>>()
    for(name in names){
      val ni=try{java.net.NetworkInterface.getByName(name)}catch(_:Throwable){null} ?: continue
      if(!ni.isUp)continue
      val addresses=java.util.Collections.list(ni.inetAddresses).filterIsInstance<java.net.Inet4Address>()
        .filter{!it.isLoopbackAddress}
      for(address in addresses)rows.add(Pair(name,address))
    }
    return rows.distinctBy{it.first+"|"+it.second.hostAddress}
      .sortedWith(compareBy<Pair<String,java.net.Inet4Address>>{if(linkLocal&&it.second.hostAddress.startsWith("169.254."))0 else 1}.thenBy{it.first})
      .take(16)
  }

  @Synchronized private fun open(context:Context,owner:String,p:JSONObject):JSONObject{
    cleanExpired()
    if(sessions.size>=MAX_SESSIONS||sessions.values.count{it.owner==owner}>=MAX_SESSIONS_PER_OWNER)
      throw IllegalStateException("TCP gateway session limit reached. Close an existing session first.")
    val host=p.optString("host","").trim()
    if(host.isEmpty()||host.length>253||host.any{it.isWhitespace()||it=='/'||it=='\\'})
      throw IllegalArgumentException("Invalid TCP target.")
    val targetAddress=resolvePrivateTarget(host)
    val port=bounded(p.optInt("port",0),1,65535,"port")
    val timeout=bounded(p.optInt("connectTimeoutMs",5000),250,120000,"connect timeout")
    val mode=p.optString("networkMode","auto").ifBlank{"auto"}
    if(mode !in listOf("auto","wifi","ethernet","interface"))throw IllegalArgumentException("Unsupported network mode.")
    val wanted=p.optString("interfaceName","").trim()
    if(mode=="interface"&&(wanted.isEmpty()||wanted.length>32))throw IllegalArgumentException("Interface name is required.")
    val cm=context.getSystemService(Context.CONNECTIVITY_SERVICE) as ConnectivityManager
    val linkLocal=targetAddress is java.net.Inet4Address&&targetAddress.hostAddress.startsWith("169.254.")
    val errors=mutableListOf<String>()
    var networkPreparation="not-required"
    fun orderedNetworks():List<android.net.Network>{
      val all=cm.allNetworks.toList()
      fun iface(n:android.net.Network)=cm.getLinkProperties(n)?.interfaceName.orEmpty()
      fun eth(n:android.net.Network)=cm.getNetworkCapabilities(n)?.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)==true
      fun wifi(n:android.net.Network)=cm.getNetworkCapabilities(n)?.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)==true
      return when(mode){
        "ethernet"->all.filter{eth(it)}
        "wifi"->all.filter{wifi(it)}
        "interface"->all.filter{iface(it)==wanted}
        else->if(linkLocal)all.filter{eth(it)}+all.filter{wifi(it)}+all.filter{!eth(it)&&!wifi(it)}
          else all.filter{wifi(it)}+all.filter{eth(it)}+all.filter{!eth(it)&&!wifi(it)}
      }.distinct()
    }
    val initialEthernetReady=orderedNetworks().any{network->
      cm.getNetworkCapabilities(network)?.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)==true&&
      cm.getLinkProperties(network)?.linkAddresses?.any{
        it.address is java.net.Inet4Address&&it.address.hostAddress.startsWith("169.254.")
      }==true
    }
    if(linkLocal&&initialEthernetReady)networkPreparation="android-ethernet-no-root"
    val perAttempt=timeout.coerceAtMost(500)
    var selected:Socket?=null
    var selectedInterface=""
    var selectedStrategy=""
    fun tryNetwork(network:android.net.Network):Boolean{
      val iface=cm.getLinkProperties(network)?.interfaceName.orEmpty()
      val socket=try{network.socketFactory.createSocket()}catch(error:Throwable){
        errors.add((iface.ifBlank{"Android Network"})+": "+(error.message?:error.javaClass.simpleName));return false
      }
      try{
        socket.tcpNoDelay=true
        socket.connect(InetSocketAddress(targetAddress,port),perAttempt)
        selected=socket;selectedInterface=iface;selectedStrategy="android-network";return true
      }catch(error:Throwable){
        try{socket.close()}catch(_:Throwable){}
        errors.add((iface.ifBlank{"Android Network"})+": "+(error.message?:error.javaClass.simpleName));return false
      }
    }
    fun trySource(source:Pair<String,java.net.Inet4Address>):Boolean{
      val socket=Socket()
      try{
        socket.tcpNoDelay=true
        socket.bind(InetSocketAddress(source.second,0))
        socket.connect(InetSocketAddress(targetAddress,port),perAttempt)
        selected=socket;selectedInterface=source.first;selectedStrategy="local-source-bind";return true
      }catch(error:Throwable){
        try{socket.close()}catch(_:Throwable){}
        errors.add(source.first+" ["+source.second.hostAddress+"]: "+(error.message?:error.javaClass.simpleName));return false
      }
    }
    for(network in orderedNetworks())if(tryNetwork(network))break
    if(selected==null)for(source in fallbackSources(mode,wanted,linkLocal))if(trySource(source))break
    if(selected==null&&linkLocal&&mode!="wifi"){
      networkPreparation=try{DkdsLinkLocalTcpRecovery.prepare(targetAddress.hostAddress,mode,wanted)}
        catch(error:Throwable){"link-local-recovery-failed: "+(error.message?:error.javaClass.simpleName)}
      for(network in orderedNetworks())if(tryNetwork(network))break
      if(selected==null)for(source in fallbackSources(mode,wanted,linkLocal))if(trySource(source))break
    }
    if(selected==null&&mode=="auto"){
      val socket=Socket()
      try{
        socket.tcpNoDelay=true
        socket.connect(InetSocketAddress(targetAddress,port),perAttempt)
        selected=socket;selectedInterface="";selectedStrategy="system-default"
      }catch(error:Throwable){
        try{socket.close()}catch(_:Throwable){}
        errors.add("system route: "+(error.message?:error.javaClass.simpleName))
      }
    }
    val socket=selected ?: throw IllegalStateException(
      "Android TCP gateway could not reach "+targetAddress.hostAddress+":"+port+" after trying "+errors.size+
      " network paths: "+(errors.take(8).joinToString(" | ").ifBlank{"no usable network/interface was exposed"}))
    val id=UUID.randomUUID().toString()
    val row=Session(id,owner,socket)
    sessions[id]=row
    return JSONObject()
      .put("sessionId",id)
      .put("localAddress",socket.localAddress?.hostAddress ?: "")
      .put("localPort",socket.localPort)
      .put("remoteAddress",socket.inetAddress?.hostAddress ?: targetAddress.hostAddress)
      .put("remotePort",socket.port)
      .put("interfaceName",selectedInterface)
      .put("routeStrategy",selectedStrategy)
      .put("networkPreparation",networkPreparation)
      .put("networkMode",mode)
  }
  private fun exchange(owner:String,p:JSONObject):JSONObject{
    val row=requireOwned(p.optString("sessionId",""),owner)
    val bytes=try{Base64.decode(p.optString("base64",""),Base64.DEFAULT)}catch(_:Throwable){
      throw IllegalArgumentException("Invalid base64 TCP payload.")
    }
    if(bytes.size>MAX_WRITE_BYTES)throw IllegalArgumentException("TCP write exceeds the 1 MiB safety limit.")
    synchronized(row){
      if(row.busy)throw IllegalStateException("TCP session already has an active exchange.")
      row.busy=true
    }
    try{
      val readTimeout=bounded(p.optInt("readTimeoutMs",5000),250,120000,"read timeout")
      val idleTimeout=bounded(p.optInt("idleTimeoutMs",120),20,10000,"idle timeout")
      val maxBytes=bounded(p.optInt("maxBytes",65536),1,MAX_RESPONSE_BYTES,"response size")
      val noReply=p.optBoolean("noReply",false)
      row.socket.getOutputStream().apply{write(bytes);flush()}
      if(noReply){row.lastUsed=System.currentTimeMillis();return JSONObject().put("base64","").put("bytesRead",0)}
      val output=ByteArrayOutputStream()
      val input=row.socket.getInputStream()
      val buffer=ByteArray(4096)
      row.socket.soTimeout=readTimeout
      while(output.size()<maxBytes){
        try{
          val count=input.read(buffer,0,minOf(buffer.size,maxBytes-output.size()))
          if(count<0)break
          if(count==0)continue
          output.write(buffer,0,count)
          row.socket.soTimeout=idleTimeout
        }catch(error:SocketTimeoutException){
          if(output.size()==0)throw IllegalStateException("TCP read timed out before any response; session closed to prevent stale replies.",error)
          break
        }
      }
      if(output.size()>=maxBytes)throw IllegalStateException("TCP response reached the configured byte limit. Session closed.")
      if(output.size()==0)throw IllegalStateException("TCP peer returned an empty response.")
      val response=output.toByteArray()
      row.lastUsed=System.currentTimeMillis()
      return JSONObject().put("base64",Base64.encodeToString(response,Base64.NO_WRAP)).put("bytesRead",response.size)
    }catch(error:Throwable){
      closeRow(row)
      throw error
    }finally{
      row.busy=false
    }
  }
}
