package __PACKAGE__;

import android.app.Activity;
import android.content.Intent;
import android.content.pm.PackageInfo;
import android.content.pm.PackageManager;
import android.content.pm.Signature;
import android.net.Uri;
import android.os.Build;
import android.os.Handler;
import android.os.Looper;
import android.provider.Settings;
import android.util.Log;

import androidx.core.content.FileProvider;

import org.json.JSONArray;
import org.json.JSONObject;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.security.MessageDigest;
import java.util.Locale;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * Self-update is explicitly user initiated. Android's package installer is
 * responsible for confirmation; no silent installation or privileged commands.
 * Downloaded APKs must match both the GitHub asset SHA256 and installed signer.
 */
final class DkdsAppUpdateManager {
    private static final String TAG = "DKDS-AppUpdate";
    private static final String REPO = "davidkane0526/DK-Data-Studio";
    private static final String API = "https://api.github.com/repos/" + REPO + "/releases?per_page=100";
    private static final String APK_ASSET = "DK-Data-Studio-arm64-v8a-release.apk";
    private static final Pattern TAG_VERSION = Pattern.compile("dkds-android-v(\\d+\\.\\d+\\.\\d+)-(a\\d{4,})");
    private static final int MAX_APK = 180 * 1024 * 1024;
    private static final long CACHE_MS=5*60*1000L;
    private static final long STALE_MS=15*60*1000L;
    private static final Object RELEASE_LOCK=new Object();
    private static JSONArray cachedReleases=null;
    private static long cachedAt=0L, retryAt=0L;
    static JSONArray fetchReleases() throws Exception{
        synchronized(RELEASE_LOCK){
            long now=System.currentTimeMillis();
            if(cachedReleases!=null&&now-cachedAt<CACHE_MS)return cachedReleases;
            if(now<retryAt){
                if(cachedReleases!=null&&now-cachedAt<STALE_MS)return cachedReleases;
                throw new IllegalStateException("GitHub API 限流，稍后自动恢复");
            }
            HttpURLConnection connection=null;
            try{
                connection=connect(API);
                JSONArray data;
                try(InputStream in=connection.getInputStream()){
                    data=new JSONArray(new String(readLimited(in,4*1024*1024),
                        java.nio.charset.StandardCharsets.UTF_8));
                }
                cachedReleases=data;cachedAt=System.currentTimeMillis();
                retryAt=0L;
                return data;
            }catch(Exception error){
                if(error instanceof GithubHttpException &&
                   (((GithubHttpException)error).status==403||((GithubHttpException)error).status==429)){
                    long fromHeader=((GithubHttpException)error).retryAt;
                    retryAt=Math.max(System.currentTimeMillis()+60*1000L,fromHeader);
                }
                if(cachedReleases!=null&&System.currentTimeMillis()-cachedAt<STALE_MS)return cachedReleases;
                throw error;
            }finally{if(connection!=null)connection.disconnect();}
        }
    }
    private static final class GithubHttpException extends IllegalStateException{
        final int status;
        final long retryAt;
        GithubHttpException(String message,int status,long retryAt){
            super(message);this.status=status;this.retryAt=retryAt;
        }
    }
    private final Activity activity;
    private final Handler main = new Handler(Looper.getMainLooper());
    private final ExecutorService worker = Executors.newSingleThreadExecutor();
    private volatile boolean closed = false;
    private volatile String state = "idle", version = "", error = "";
    private volatile int progress = 0;
    private volatile Candidate candidate;
    private volatile File downloaded;
    private volatile boolean resumeInstaller = false;

    private static final class Candidate {
        final String version, buildId, url, sha256;
        final int size;
        Candidate(String version, String buildId, String url, String sha256, int size) {
            this.version=version;this.buildId=buildId;this.url=url;this.sha256=sha256;this.size=size;
        }
    }
    DkdsAppUpdateManager(Activity activity) {
        this.activity=activity;
    }
    JSONObject status() throws org.json.JSONException {
        String installed="";
        try{installed=activity.getPackageManager().getPackageInfo(activity.getPackageName(),0).versionName;}
        catch(Exception ignored){}
        return new JSONObject().put("status",state).put("version",version)
            .put("installedVersion",installed)
            .put("progress",progress).put("error",error);
    }
    static int compareVersions(String a, String b) {
        String[] x=a.split("\\."),y=b.split("\\.");
        if(x.length!=3||y.length!=3)return 0;
        for(int i=0;i<3;i++){
            int d=Integer.compare(Integer.parseInt(x[i]),Integer.parseInt(y[i]));
            if(d!=0)return d;
        }
        return 0;
    }
    private static boolean trusted(URL url) {
        if(!"https".equalsIgnoreCase(url.getProtocol()))return false;
        String h=url.getHost().toLowerCase(Locale.ROOT);
        return h.equals("api.github.com")||h.equals("github.com")||
            h.equals("release-assets.githubusercontent.com")||
            h.endsWith(".githubusercontent.com");
    }
    private static GithubHttpException responseError(int status,HttpURLConnection c,String url){
        String remaining=c.getHeaderField("X-RateLimit-Remaining");
        long reset=0L,retry=0L;
        try{reset=Long.parseLong(c.getHeaderField("X-RateLimit-Reset"))*1000L;}catch(Exception ignored){}
        try{retry=Long.parseLong(c.getHeaderField("Retry-After"))*1000L+System.currentTimeMillis();}catch(Exception ignored){}
        boolean limited=(status==403||status==429)&&("0".equals(remaining)||retry>0L);
        String kind=limited?"GitHub API 限流":status==403?"GitHub 拒绝访问":"GitHub 请求失败";
        long at=retry>0L?retry:reset;
        String detail=at>System.currentTimeMillis()?"，稍后重试":"";
        return new GithubHttpException(kind+" (HTTP "+status+")"+detail+
            (url.startsWith("https://api.github.com")?" · API":" · 下载"),status,at);
    }
    static HttpURLConnection connect(String raw) throws Exception {
        URL url=new URL(raw);
        for(int redirect=0;redirect<6;redirect++){
            if(!trusted(url))throw new SecurityException("Untrusted download host");
            HttpURLConnection c=(HttpURLConnection)url.openConnection();
            c.setInstanceFollowRedirects(false);
            c.setRequestProperty("User-Agent","DK-Data-Studio-Android-Updater");
            c.setRequestProperty("Accept","application/vnd.github+json");
            c.setConnectTimeout(12000);
            c.setReadTimeout(20000);
            int status=c.getResponseCode();
            if(status==301||status==302||status==303||status==307||status==308){
                String location=c.getHeaderField("Location");
                if(location==null)throw new IllegalStateException("Missing redirect target");
                URL next=new URL(url,location);c.disconnect();url=next;continue;
            }
            if(status!=200){
                GithubHttpException problem=responseError(status,c,raw);
                c.disconnect();throw problem;
            }
            return c;
        }
        throw new IllegalStateException("Too many GitHub redirects");
    }
    static byte[] readLimited(InputStream in,int maximum)throws Exception{
        java.io.ByteArrayOutputStream out=new java.io.ByteArrayOutputStream();
        byte[] buf=new byte[8192];int n;
        while((n=in.read(buf))!=-1){
            if(out.size()+n>maximum)throw new IllegalStateException("Release data too large");
            out.write(buf,0,n);
        }
        return out.toByteArray();
    }
    static String hex(byte[] hash){
        StringBuilder result=new StringBuilder(hash.length*2);
        for(byte b:hash)result.append(String.format(Locale.ROOT,"%02x",b&255));
        return result.toString();
    }
    static int compareBuildIds(String a,String b){
        try{return Long.compare(Long.parseLong(a.substring(1)),Long.parseLong(b.substring(1)));}
        catch(Exception ignored){return 0;}
    }
    private Candidate latest() throws Exception {
        JSONArray releases=fetchReleases();
        Candidate chosen=null;
        for(int i=0;i<releases.length();i++){
            JSONObject row=releases.getJSONObject(i);
            Matcher tagMatcher=TAG_VERSION.matcher(row.optString("tag_name"));
            if(row.optBoolean("draft",false)||!tagMatcher.matches())continue;
            JSONArray assets=row.optJSONArray("assets");if(assets==null)continue;
            JSONObject apk=null;String releaseVersion=tagMatcher.group(1),releaseBuildId=tagMatcher.group(2);
            for(int j=0;j<assets.length();j++){
                JSONObject item=assets.getJSONObject(j);
                if(APK_ASSET.equals(item.optString("name")))apk=item;

            }
            if(apk==null||releaseVersion.isEmpty())continue;
            String sha=apk.optString("digest");
            String url=apk.optString("browser_download_url");
            long size=apk.optLong("size",0);
            if(!sha.matches("sha256:[a-fA-F0-9]{64}")||
                size<100000||size>MAX_APK||
                !url.startsWith("https://github.com/"+REPO+"/releases/download/"+
                    row.getString("tag_name")+"/"))continue;
            Candidate candidate=new Candidate(releaseVersion,releaseBuildId,url,sha.substring(7).toLowerCase(Locale.ROOT),(int)size);
            if(chosen==null||compareVersions(candidate.version,chosen.version)>0||
                (compareVersions(candidate.version,chosen.version)==0&&compareBuildIds(candidate.buildId,chosen.buildId)>0))chosen=candidate;
        }
        return chosen;
    }
    void checkNow(){
        if(closed||"checking".equals(state)||"downloading".equals(state))return;
        state="checking";error="";
        worker.execute(()->{
            try{
                Candidate found=latest();
                if(closed)return;
                String installed=activity.getPackageManager()
                    .getPackageInfo(activity.getPackageName(),0).versionName;
                if(found==null||compareVersions(found.version,installed)<=0){
                    candidate=null;version=installed;state="current";return;
                }
                if(candidate==null||!candidate.version.equals(found.version)||
                    !candidate.sha256.equals(found.sha256))downloaded=null;
                candidate=found;version=found.version;
                state=downloaded!=null&&downloaded.exists()?"ready":"available";
            }catch(Exception ex){state="error";error=String.valueOf(ex.getMessage());Log.w(TAG,"Update check failed",ex);}
        });
    }
    void downloadAndInstall(){
        if(closed||"downloading".equals(state)||"checking".equals(state))return;
        state="downloading";progress=0;error="";
        worker.execute(()->{
            try{
                Candidate selected=candidate;
                if(selected==null)throw new IllegalStateException("请先检查程序更新");
                File apk=downloaded;
                if(apk!=null&&apk.exists()){
                    try{verifyDownloaded(apk,selected);validateApk(apk,selected.version);}
                    catch(Exception invalid){
                        Log.w(TAG,"Cached APK invalid; downloading again",invalid);
                        downloaded=null;apk=null;
                    }
                }
                if(apk==null||!apk.exists()){
                    apk=download(selected);
                    validateApk(apk,selected.version);
                    downloaded=apk;
                }
                if(closed)return;
                state="ready";progress=100;
                requestInstaller(apk);
            }catch(Exception ex){
                state="error";error=String.valueOf(ex.getMessage());Log.w(TAG,"APK update rejected",ex);
            }
        });
    }
    private void verifyDownloaded(File apk,Candidate selected)throws Exception{
        if(!apk.isFile()||apk.length()!=selected.size)throw new SecurityException("APK 缓存大小不匹配");
        MessageDigest digest=MessageDigest.getInstance("SHA-256");
        try(InputStream in=new FileInputStream(apk)){
            byte[] buffer=new byte[65536];int n;
            while((n=in.read(buffer))!=-1)digest.update(buffer,0,n);
        }
        if(!hex(digest.digest()).equals(selected.sha256))throw new SecurityException("APK 缓存校验值不匹配");
    }
    private File download(Candidate selected)throws Exception{
        state="downloading";progress=0;error="";
        File folder=new File(activity.getCacheDir(),"native-updates");
        if(!folder.exists()&&!folder.mkdirs())throw new IllegalStateException("无法建立下载目录");
        File destination=new File(folder,"verified-update.apk");
        File temp=new File(folder,"download.tmp");
        if(temp.exists())temp.delete();
        HttpURLConnection c=connect(selected.url);
        MessageDigest digest=MessageDigest.getInstance("SHA-256");
        long count=0;
        try(InputStream in=c.getInputStream();FileOutputStream out=new FileOutputStream(temp)){
            byte[] part=new byte[65536];int n;
            while((n=in.read(part))!=-1){
                count+=n;
                if(count>MAX_APK||count>selected.size)throw new IllegalStateException("APK exceeds declared size");
                out.write(part,0,n);digest.update(part,0,n);
                progress=(int)Math.min(99,count*100/selected.size);
            }
            out.getFD().sync();
        }catch(Exception e){temp.delete();throw e;}
        finally{c.disconnect();}
        if(count!=selected.size||!hex(digest.digest()).equals(selected.sha256)){
            temp.delete();throw new SecurityException("APK SHA-256 校验失败，已拒绝安装");
        }
        if(destination.exists())destination.delete();
        if(!temp.renameTo(destination))throw new IllegalStateException("无法完成下载文件校验");
        return destination;
    }
    @SuppressWarnings("deprecation")
    private Signature[] signatures(PackageInfo info){
        if(info==null)return new Signature[0];
        if(Build.VERSION.SDK_INT>=28)
            return info.signingInfo==null?new Signature[0]:info.signingInfo.getApkContentsSigners();
        return info.signatures==null?new Signature[0]:info.signatures;
    }
    @SuppressWarnings("deprecation")
    private void validateApk(File apk,String expectedVersion)throws Exception{
        final PackageManager pm=activity.getPackageManager();
        final int flags=Build.VERSION.SDK_INT>=28?PackageManager.GET_SIGNING_CERTIFICATES:PackageManager.GET_SIGNATURES;
        PackageInfo archive=pm.getPackageArchiveInfo(apk.getAbsolutePath(),flags);
        PackageInfo installed=pm.getPackageInfo(activity.getPackageName(),flags);
        if(archive==null||!activity.getPackageName().equals(archive.packageName)
            ||!expectedVersion.equals(archive.versionName))
            throw new SecurityException("APK 包名或版本不匹配");
        Signature[] trusted=signatures(installed),received=signatures(archive);
        if(trusted.length==0||received.length==0||
            !MessageDigest.isEqual(trusted[0].toByteArray(),received[0].toByteArray()))
            throw new SecurityException("APK 签名证书与当前安装版本不一致");
    }
    private void requestInstaller(File apk){
        main.post(()->{
            if(closed||activity.isFinishing())return;
            try{
                if(Build.VERSION.SDK_INT>=26&&!activity.getPackageManager().canRequestPackageInstalls()){
                    resumeInstaller=true;state="permission";
                    Intent settings=new Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES,
                        Uri.parse("package:"+activity.getPackageName()));
                    activity.startActivity(settings);
                    return;
                }
                resumeInstaller=false;
                Uri content=FileProvider.getUriForFile(activity,
                    activity.getPackageName()+".updates",apk);
                Intent install=new Intent(Intent.ACTION_VIEW);
                install.setDataAndType(content,"application/vnd.android.package-archive");
                install.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
                activity.startActivity(install);
                state="installer";
            }catch(Exception ex){state="error";error=String.valueOf(ex.getMessage());}
        });
    }
    void onResume(){
        if(resumeInstaller&&downloaded!=null&&downloaded.exists()&&
            (Build.VERSION.SDK_INT<26||activity.getPackageManager().canRequestPackageInstalls())){
            resumeInstaller=false;requestInstaller(downloaded);
        }
    }
    void stop(){
        closed=true;worker.shutdownNow();
    }
}
