{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dk-data-studio.local/schema/plugin-manifest-v1.8.json",
  "title": "DK Data Studio Plugin Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "version", "apiVersion", "entry", "requiresCore"],
  "properties": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "name": {"type":"string","minLength":1},
    "version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"},
    "apiVersion": {"const":"1.8.0"},
    "entry": {"type":"string","pattern":"^[^/\\\\]+\\.js$"},
    "enabled": {"type":"boolean"},
    "order": {"type":"number"},
    "description": {"type":"string"},
    "requiresCore": {
      "type":"array",
      "uniqueItems":true,
      "items": {
        "enum": [
          "runtime", "events", "status", "io", "science", "services", "modules", "recipes",
          "capabilities", "state", "project", "workspace", "parameters",
          "data.flow", "data.artifacts", "data.entities", "data.types", "data.model", "data.formula",
          "workflow", "analysis.providers", "analysis.detectors", "charts", "charts.providers",
          "ui.dom", "ui.components", "ui.workspace", "ui.scientific-plot", "ui.plot-views",
          "ui.actions", "ui.selection", "ui.interaction", "ui.menus", "ui.context-menus",
          "ui.activities", "ui.top-workspace", "ui.toolbar", "ui.status-bar", "ui.shortcuts",
          "ui.pages", "ui.styles", "ui.portable", "ui.edit"
        ]
      }
    },
    "capabilities": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "workspace": {
      "type":"object",
      "properties": {
        "role":{"enum":["top"]},
        "activity":{"type":"string"},
        "icon":{"type":"string"},
        "title":{"type":"string"},
        "defaultSuper":{"type":"boolean"}
      }
    },
    "window": {
      "type":"object",
      "required":["activity"],
      "properties": {
        "activity":{"type":"string"},
        "title":{"type":"string"},
        "runtime":{"type":"string"},
        "scripts":{"type":"array","items":{"type":"string"}},
        "dependencies":{"type":"array","items":{"type":"string"}},
        "prewarm":{"type":"boolean"},
        "reuse":{"type":"boolean"},
        "persistence":{"enum":["project","memory","none"]},
        "width":{"type":"number","exclusiveMinimum":0},
        "height":{"type":"number","exclusiveMinimum":0},
        "minWidth":{"type":"number","exclusiveMinimum":0},
        "minHeight":{"type":"number","exclusiveMinimum":0}
      }
    }
  }
}
